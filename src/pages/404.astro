---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada | Permiso de rodaje en Cali" description="Esta página no existe. Vuelve al inicio para preparar el permiso de rodaje en espacio público de Cali." path="/404/" noindex>
  <div class="envoltura no-encontrada">
    <p class="mono muted">404</p>
    <h1 class="h-hero">Esta página no existe</h1>
    <p class="lead">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <p><a class="boton grande" href="/">Volver al inicio</a></p>
  </div>
</Base>

<style>
  .no-encontrada { display: grid; gap: 1rem; justify-items: start; padding-block: 6rem 8rem; }
  .no-encontrada p { margin: 0; }
</style>
