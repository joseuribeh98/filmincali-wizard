---
import '../styles/global.css';
import photos from '../lib/photos.json';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Dark top bar, for pages that open with the dark hero. */
  dark?: boolean;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
}
const {
  title, description, path = '/', dark = false, image = '/og.jpg', noindex = false, faq,
  imageAlt = 'Permiso de rodaje en espacio público de Cali: formatos F004 a F008 llenos desde el navegador',
} = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Permiso de rodaje en Cali',
    url: new URL('/', Astro.site).toString(),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    inLanguage: 'es-CO',
    description: 'Herramienta independiente para llenar los formatos F004 a F008 del permiso de rodaje en espacio público de Santiago de Cali.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'COP' },
    author: { '@type': 'Person', name: 'Jose Uribe', url: 'https://joseuribe.dev' },
    areaServed: { '@type': 'City', name: 'Santiago de Cali' },
  },
];
if (faq?.length) ld.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0c0c0e" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Permiso de rodaje en Cali" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="author" content="Jose Uribe" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <header class:list={['topbar', { dark }]}>
      <div class="wrap topbar-inner">
        <a class="brand" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="10" width="18" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 10 19.6 5.3l1.2 3.9" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8 8.6 2.4 1.4M12.6 7.2 15 8.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span>Permiso de rodaje <span class="brand-city">Cali</span></span>
        </a>
        <nav aria-label="Secciones">
          <a href="/#como-funciona">Cómo funciona</a>
          <a href="/agentes/">Para agentes de IA</a>
          <a href="https://github.com/joseuribeh98/filmincali-wizard" class="nav-gh">Código</a>
          <a class="btn sm" href="/#solicitud">Empezar <span class="short">solicitud</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <p class="footer-brand">Permiso de rodaje Cali</p>
          <p class="muted">Herramienta independiente hecha por <a href="https://joseuribe.dev">Jose Uribe</a>. No es un servicio de la Alcaldía de Santiago de Cali ni de la Comisión Fílmica.</p>
        </div>
        <div class="muted footer-legal">
          <p>Tus datos se procesan en tu navegador y no se envían a ningún servidor. Sin analítica ni cookies. <a href="https://github.com/joseuribeh98/filmincali-wizard">Código abierto en GitHub</a>. La herramienta no radica la solicitud ni garantiza su aprobación.</p>
          <p>Fotos de Unsplash:
            {photos.map((f, i) => (
              <>{i > 0 && '; '}<a href={f.source}>{f.title}</a>, de <a href={f.profile}>{f.author}</a></>
            ))}.
          </p>
          <p>Fuente de los formatos y del proceso: <a href="https://www.filmincali.com.co/permiso/" rel="noopener">filmincali.com.co</a>. Dudas oficiales: filmincali@cali.gov.co.</p>
        </div>
      </div>
    </footer>
    <script>
      // Every link to another domain opens in a new tab and gets the external link icon.
      const markExternal = (root: ParentNode) => {
        root.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
          if (a.host === location.host || a.dataset.external) return;
          a.dataset.external = '1';
          a.target = '_blank';
          a.rel = [...new Set([...(a.rel ? a.rel.split(' ') : []), 'noopener', 'noreferrer'])].join(' ');
          a.classList.add('external');
          const sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = ' (abre en una pestaña nueva)';
          a.append(sr);
        });
      };
      markExternal(document);
      new MutationObserver(() => markExternal(document)).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>

<style>
  .topbar { position: sticky; top: 0; z-index: 20; background: rgb(250 250 249 / 0.82); backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
  .topbar.dark { background: rgb(12 12 14 / 0.78); border-bottom-color: var(--night-line); color: var(--night-ink); }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 600; letter-spacing: -0.02em; text-decoration: none; }
  .brand-city { color: var(--accent-deep); }
  .brand span { white-space: nowrap; }
  .brand svg { flex: none; }
  @media (max-width: 30rem) { .short { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .topbar.dark .brand-city { color: var(--accent); }
  .topbar nav { display: flex; align-items: center; gap: 1.5rem; font-size: 0.9rem; }
  .topbar nav a:not(.btn) { text-decoration: none; color: inherit; opacity: 0.75; }
  .topbar nav a:not(.btn):hover { opacity: 1; }
  .topbar.dark .btn { background: var(--night-ink); color: var(--night); border-color: var(--night-ink); }
  .site-footer { border-top: 1px solid var(--line); margin-top: 6rem; padding-block: 3rem; font-size: 0.875rem; }
  .footer-inner { display: grid; grid-template-columns: 1fr 1.4fr; gap: 2rem; }
  .footer-brand { font-weight: 600; margin-bottom: 0.4rem; }
  .footer-legal p:last-child { margin: 0; }
  @media (max-width: 44rem) {
    .topbar nav a:not(.btn) { display: none; }
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
